# Normalize text files to LF.
* text=auto eol=lf

# Images and other binary assets.
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.avif binary
*.bmp binary
*.tif binary
*.tiff binary
*.ico binary
*.svg binary
*.pdf binary

# Fonts.
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

# Archives.
*.zip binary
*.7z binary
*.gz binary

# Web source and documentation.
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.txt text eol=lf
